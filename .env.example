# MySQL (Hostinger hPanel → Databases). Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://hathaway:hathaway_dev@127.0.0.1:3307/hathaway

# Admin session signing key — generate with: openssl rand -base64 32
SESSION_SECRET=

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@hathawayjourney.com
SEED_ADMIN_PASSWORD=

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hathaway

# Public site URL (used for WA message links, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification code (optional): only the content="..." value
NEXT_PUBLIC_GSC_VERIFICATION=
